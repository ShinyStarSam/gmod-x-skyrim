{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/../build/skse",
      "toolchainFile": "${sourceDir}/../.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "default", "configuration": "RelWithDebInfo" },
    { "name": "debug", "configurePreset": "default", "configuration": "Debug" }
  ]
}
